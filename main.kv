                    size_hint:None,None
                    background_color:1,1,1,1
                    size:30,30

                    pos_hint:{"center_y":0.5}
                    on_release:
                        root.time_picker()

            # 🚀 Schedule Button
            HoverButton:
                text: "Schedule Wish"
                font_size: 18
                bold: True
                background_normal: ""
                background_color: 0,0,0,0
                background_active:""
                background_down:""
                size_hint:0.7,0.1
                pos_hint:{"center_x":0.5}
                canvas.before:
                    Color:
                        rgba:1,1,1,1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [20]
                        texture:Gradient.horizontal((0.0, 0.42, 1.0, 1.0),(1.0, 0.411, 0.705, 1.0))

                on_press: root.schedule_wish()




        #overlay
        Button:
            id:overlay
            opacity:1
            size_hint:0,0
            #disabled:True
            background_normal:""
            background_down:""
            background_color:0,0,0,0
            on_release:
                root.close_side_menu()
            canvas.before:
                Color:
                    rgba:0,0,0,self.opacity*0.45
                Rectangle:
                    pos:self.pos
                    size:self.size

        # Side Bar
        HoverButton:
            id: menu_btn
            size_hint:None,None
            size:30,30
            background_normal:"image/menu.png"
            background_down:"image/menu.png"
            background_color:1,1,1,1
            pos_hint:{"x":0.01,"center_y":0.9}
            on_press:
                root.side_menu()

        BoxLayout:
            id: side_panel
            orientation:"vertical"
            pos_hint:{"center_y":0.45}
