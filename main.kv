            id:content_area

            Button:
                id: save_btn
                text: "Save"
                size_hint: None, None
                size: "120dp", "45dp"
                pos_hint: {"right": 0.98, "y": 0.02}

                opacity: 0
                disabled: True

                on_release:
                    root.save_current_settings()