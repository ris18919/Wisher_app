#:import dp kivy.metrics.dp
#:import Gradient kivy_gradient.Gradient
#:import CheckBox kivy.uix.checkbox
#:import DropDown kivy.uix.dropdown

<ProfileSpinnerOption@SpinnerOption>:
    background_normal: ""
    background_color: (0, 0, 0, 0)  # Transparent base
    color: 1, 1, 1, 1
    font_name: "fonts/Noto_Sans/NotoSans-VariableFont.ttf"
    height: "40dp"

    canvas.before:
        Color:
            rgba: 0.156, 0.156, 0.168, 1  # Dark background
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [10]


<AdvancedContent>:
    orientation: "vertical"
    spacing: "15dp"
    padding: "20dp"

    Label:
        text: "Advanced Settings"
        font_size: "26sp"
        font_name:"NotoSans"
        bold: True
        color: 1,1,1,1
        size_hint_y: None
        height: "40dp"
        pos_hint:{"center_x":0.6}

    Label:
        text: "Scheduler"
        font_size: "20sp"
        font_name:"NotoSans"
        bold: True
        color: .2,.6,1,1
        size_hint_y: None
        height: "35dp"
        pos_hint:{"center_x":0.6}

    BoxLayout:
        pos_hint:{"center_x":0.6}
        size_hint:0.6,0.4


        Label:
            text: "Scheduler Status"
            halign: "center"
            valign: "middle"
            text_size: self.size

        Label:
            id: scheduler_status
            text: "Running"
            font_name:"NotoSans"
            color: 0,1,0,1
            bold: True

    BoxLayout:
        pos_hint:{"center_x":0.6}
        size_hint:0.6,0.1

        Label:
            text: "Scheduler Interval"
            font_name:"NotoSans"

        Spinner:
            id: interval_spinner
            text: "20 Seconds"
            values:
                (
                "10 Seconds",
                "20 Seconds",
                "30 Seconds",
                "1 Minute"
                )

    Widget:
        size_hint_y: None
        height: "10dp"

    BoxLayout:
        spacing: "10dp"
        pos_hint:{"center_x":0.6}
        size_hint:0.6,0.1

        Button:
            text: "Start Scheduler"
            font_name:"NotoSans"
            background_normal: ""
            background_color: 0.18,0.65,0.30,1

            on_release:
                root.start_scheduler()

        Button:
            text: "Stop Scheduler"
            font_name:"NotoSans"
            background_normal: ""
            background_color: 0.85,0.20,0.20,1

            on_release:
                root.stop_scheduler()

        Button:
            text: "Restart Scheduler"
            font_name:"NotoSans"
            background_normal: ""
            background_color: 0.15,0.55,1,1

            on_release:
                root.restart_scheduler()

    Widget:
    Button:
        text:"Save"
        size_hint:0.2,0.1
        color:0.2,0.2,1,1
        pos_hint:{"center_x":0.6}
        on_press:
            root.save_adv_settings()

<AboutContent>:
    orientation: "vertical"
    spacing: "12dp"
    padding: "20dp"

    Label:
        text: "About"
        font_size: "26sp"
        font_name:"NotoSans"
        color: 1,1,1,1
        size_hint_y: None
        height: "40dp"
        pos_hint:{"center_x":0.55}

    BoxLayout:
        orientation: "vertical"
        spacing: "8dp"
        size_hint:0.6,0.4
        pos_hint:{"center_x":0.55}

        canvas.before:
            Color:
                rgba: 1,1,1,.08
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [12]

        padding: "15dp"

        Label:
            text: "App Version"
            font_name:"NotoSans"
            bold: True
            color: .3,.7,1,1
            size_hint_y: None
            height: "25dp"

        Label:
            text: "Wisher v1.0.0"
            font_name:"NotoSans"
            halign: "center"
            text_size: self.size
            size_hint_y: None
            height: "30dp"

    BoxLayout:
        orientation: "vertical"
        spacing: "8dp"
        size_hint:0.6,0.4
        pos_hint:{"center_x":0.55}

        canvas.before:
            Color:
                rgba: 1,1,1,.08
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [12]

        padding: "15dp"

        Label:
            text: "Developer"
            font_name:"NotoSans"
            bold: True
            color: .3,.7,1,1
            size_hint_y: None
            height: "25dp"

        Label:
            text: "Rishabh Jadon"
            font_name:"NotoSans"
            halign: "center"
            text_size: self.size
            size_hint_y: None
            height: "30dp"

    Button:
        text: "Terms & Conditions"
        font_name:"NotoSans"
        size_hint:0.6,0.1
        pos_hint:{"center_x":0.55}
        background_normal: ""
        background_color: .20,.20,.20,1

    Button:
        text: "Privacy Policy"
        font_name:"NotoSans"
        size_hint:0.6,0.1
        pos_hint:{"center_x":0.55}
        background_normal: ""
        background_color: .20,.20,.20,1

    Button:
        text: "Open Source Licenses"
        font_name:"NotoSans"
        pos_hint:{"center_x":0.55}
        size_hint:0.6,0.1
        background_normal: ""
        background_color: .20,.20,.20,1

    Button:
        text: "Rate App"
        font_name:"NotoSans"
        pos_hint:{"center_x":0.55}
        size_hint:0.6,0.1
        background_normal: ""
        background_color: 0.15,0.55,1,1

        on_release:
            root.rate_app()

    Button:
        text: "Share App"
        font_name:"NotoSans"
        pos_hint:{"center_x":0.55}
        size_hint:0.6,0.1
        background_normal: ""
        background_color: .30,.70,.30,1

        on_release:
            root.share_app()

    Widget:

<GeneralContent>:
    orientation: "vertical"
    spacing: "15dp"
    padding: "20dp"

    Label:
        text: "General Settings"
        font_name:"NotoSans"
        font_size: "24sp"
        bold: True
        color: 1,1,1,1
        size_hint_y: None
        height: "40dp"
        pos_hint:{"center_x":0.6}

    # ---------------- Startup ----------------

    Label:
        text: "Startup"
        font_name:"NotoSans"
        font_size: "18sp"
        color: .2,.6,1,1
        size_hint_y: None
        height: "35dp"
        pos_hint:{"center_x":0.6}

    BoxLayout:
        size_hint:0.6,0.4
        pos_hint:{"center_x":0.6}

        Label:
            text: "Launch app at system startup"
            font_name:"NotoSans"
            font_size:"14sp"
            halign: "center"
            valign: "middle"
            text_size: self.size

        Switch:
            id: startup_switch

    BoxLayout:
        size_hint:0.6,0.4
        pos_hint:{"center_x":0.6}

        Label:
            text: "Minimize to system tray on close"
            font_name:"NotoSans"
            font_size:"14sp"
            halign: "center"
            valign: "middle"
            text_size: self.size

        Switch:
            id: tray_switch

    BoxLayout:
        size_hint:0.6,0.4
        pos_hint:{"center_x":0.6}

        Label:
            text: "Start scheduler automatically"
            font_name:"NotoSans"
            halign: "center"
            valign: "middle"
            text_size: self.size

        Switch:
            id: scheduler_switch


    Widget:
        size_hint_y: None
        height: "10dp"

    # ---------------- Date & Time ----------------

    Label:
        text: "Date & Time"
        font_name:"NotoSans"
        font_size: "18sp"
        color: .2,.6,1,1
        size_hint_y: None
        height: "35dp"
        pos_hint:{"center_x":0.6}

    BoxLayout:
        size_hint:0.6,0.4
        pos_hint:{"center_x":0.6}

        Label:
            text: "Time Format"
            font_name:"NotoSans"

        Spinner:
            id: time_spinner
            text: "12-Hour"
            values: ("12-Hour","24-Hour")

    BoxLayout:
        size_hint:0.6,0.4
        pos_hint:{"center_x":0.6}

        Label:
            text: "Date Format"
            font_name:"NotoSans"

        Spinner:
            id: date_spinner
            text: "DD/MM/YYYY"
            values:
                ("DD/MM/YYYY",
                "MM/DD/YYYY",
                "YYYY/MM/DD")

    BoxLayout:
        size_hint:0.6,0.4
        pos_hint:{"center_x":0.6}

        Label:
            text: "Time Zone"
            font_name:"NotoSans"

        Spinner:
            id: timezone_spinner
            text: "Asia/Kolkata"
            values:
                ("Asia/Kolkata",
                "UTC",
                "America/New_York",
                "Europe/London")

    Widget:

    #Button:
    #    id:save
    #    text: "Save"
    #    size_hint_x:None
    #    size_hint_y: None
    #    height: "45dp"
    #    pos_hint:{"center_x":0.6}

    #    on_release:
    #        root.save_general_settings()

<StorageContent>:
    orientation: "vertical"
    spacing: "15dp"
    padding: "20dp"


    Label:
        text: "Storage"
        font_size: "24sp"
        font_name:"NotoSans"
        bold: True
        color: 1,1,1,1
        size_hint_y: None
        height: "40dp"
        pos_hint:{"center_x":0.6}


    Button:
        text: "Clear Cache"
        size_hint:0.3,0.1
        background_normal: ""
        background_color: 0.25,0.25,0.25,1
        pos_hint:{"center_x":0.6}
        on_release:
            root.clear_cache()

    Button:
        text: "Clear History"
        size_hint:0.3,0.1
        background_normal: ""
        background_color: 0.25,0.25,0.25,1
        pos_hint:{"center_x":0.6}
        on_release:
            root.clear_history()

    Button:
        text: "Delete Failed Wishes"
        pos_hint:{"center_x":0.6}
        size_hint:0.3,0.1
        background_normal: ""
        background_color: 0.25,0.25,0.25,1
        on_release:
            root.delete_failed()

    Button:
        text: "Delete All Wishes"
        pos_hint:{"center_x":0.6}
        size_hint:0.3,0.1
        background_normal: ""
        background_color: 0.8,0.15,0.15,1
        on_release:
            root.delete_all()

    Widget:



<NotificationContent>:

    orientation:"vertical"
    spacing:15
    padding:20

    Label:
        text:"Notification Settings"
        font_name:"NotoSans"
        font_size:"22sp"
        size_hint_y:None
        height:"40dp"
        pos_hint:{"center_x":0.6}

    BoxLayout:
        size_hint:0.4,0.1
        pos_hint:{"center_x":0.6}

        Label:
            text:"Enable Notifications"
            font_size:"14sp"
            font_name:"NotoSans"


        Switch:
            id: notification_switch

    BoxLayout:
        size_hint:0.4,0.1
        pos_hint:{"center_x":0.6}

        Label:
            text:"Notification Sound"
            font_size:"14sp"
            font_name:"NotoSans"

        Switch:
            id: sound_switch

    BoxLayout:
        size_hint:0.4,0.1
        pos_hint:{"center_x":0.6}

        Label:
            text:"Notification Vibration"
            font_size:"14sp"
            font_name:"NotoSans"

        Switch:
            id: vibration_switch

    BoxLayout:
        size_hint:0.4,0.1
        pos_hint:{"center_x":0.6}

        Label:
            text:"Reminder Before Wish"
            font_size:"14sp"
            font_name:"NotoSans"

        Spinner:
            text:"15 minutes"
            values:
                ("5 minutes","15 minutes","30 minutes","1 hour")

    Widget:


<HistoryCard>:

    size_hint_y:None
    height:"60dp"
    spacing:5

    canvas.before:
        Color:
            rgba:.15,.15,.15,1
        RoundedRectangle:
            pos:self.pos
            size:self.size
            radius:[8]

    Label:
        text:root.name

    Label:
        text:root.platform

    Label:
        text:root.contact
        size_hint_x:None
        width:"200dp"
    Label:
        text:root.subject

    Label:
        text:root.date

    Label:
        text:root.time

    Label:
        text:root.status


<PlatformDialogContent@MDBoxLayout>
    #size_hint:0.9,0.9
    id:channel_drop
    orientation:"vertical"
    #adaptive_height:True
    spacing:"15dp"
    padding:"20dp"


    BoxLayout:
        orientation: "vertical"
        adaptive_height: True
        size_hint_x: None
        width: "180dp"
        pos_hint: {"center_x": .5}
        spacing: "15dp"

        BoxLayout:
            adaptive_height:True
            spacing: "10dp"
            size_hint_x:1

            CheckBox:
                id:email_cb
                color:0,0,0,1
                #on_active: root.update_platform_text()
                size_hint: None,None
                size:"30dp","30dp"
                #pos_hint:{"center_x":0.5}

            Button:
                id:email_btn
                text:"Email"
                background_normal:""
                background_down:""
                background_color:0,0,0,0
                color:0,0,0,1
                text_size:self.width,None
                halign:"center"
                valign:"middle"
                on_release:
                    email_cb.active=not email_cb.active

        BoxLayout:
            adaptive_height:True
            spacing: "10dp"
            size_hint_x:1

            CheckBox:
                id:sms_cb
                color:0,0,0,1
                #on_active:root.update_platform_text()
                size_hint:None,None
                size:"30dp","30dp"
                #pos_hint:{"center_x":0.5}

            Button:
                id:sms_btn
                text:"SMS"
                background_normal:""
                background_down:""
                background_color:0,0,0,0
                color:0,0,0,1
                text_size:self.size
                halign:"center"
                valign:"middle"
                on_press:
                    sms_cb.active=not sms_cb.active

        BoxLayout:
            adaptive_height:True
            spacing: "10dp"
            size_hint_x:1

            CheckBox:
                id:whatsapp_cb
                color:0,0,0,1
                #on_active:root.update_platform_text()
                size_hint:None,None
                size:"30dp","30dp"

                #pos_hint:{"center_x":0.5}

            Button:
                id:whatsapp_btn
                text:"WhatsApp"
                background_normal:""
                background_color:0,0,0,0
                color:0,0,0,1
                text_size:self.size
                halign:"center"
                valign:"middle"
                size_hint_x:1

                on_press:
                    whatsapp_cb.active=not whatsapp_cb.active

<GradientLabel@Label>:
    font_size: 80
    color:255/255,243/255,239/255
    opacity: 0
    canvas.before:
        Color:
            rgba:1,1,1,1
        Rectangle:
            pos:self.pos
            size:self.size
            texture:Gradient.vertical((0.96, 0.76, 0.76, 1),(255/255,243/255,239/255))


<HoverButton>:
    background_normal: ""
    background_color: 1,1,1,1


