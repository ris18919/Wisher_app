<EditProfileScreen>:

    FloatLayout:

        canvas.before:
            Rectangle:
                pos: self.pos
                size: self.size


        Image:
            id:image
            source:"image/wisher-app-background_login.jpg"
            size:1,1
            fit_mode:"fill"
            pos:self.pos
            size:self.size

        Button:
            background_normal:"image/arrow_back.png"
            background_down:""
            background_color: (0.27, 0.51, 0.71, 1) if self.state == "down" else (1,1,1,1)
            size_hint:None,None
            size:40,40
            pos_hint:{"center_x":0.06,"center_y":0.92}
            on_press:
                app.root.current="home"

        BoxLayout:
            orientation: "vertical"
            size_hint: None, .82
            width:"350dp"
            pos_hint: {"center_x":.5,"center_y":.5}
            spacing: "18dp"
            padding: "25dp"

            canvas.before:
                Color:
                    rgba: 1,1,1,.15
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [20]
                Color:
                    rgba:1,1,1,.35
                Line:
                    rounded_rectangle:
                        (self.x,self.y,self.width,self.height,20)
                    width:1.2

            Label:
                text: "Edit Profile"
                bold: True
                font_size: "28sp"
                color: 1,1,1,1
                size_hint_y: None
                height: "45dp"

            AnchorLayout:
                anchor_x: "center"
                anchor_y: "center"
                size_hint_y: None
                height: "120dp"

                BoxLayout:
                    orientation: "vertical"
                    size_hint: None,None
                    size: "120dp","120dp"

                    Image:
                        id: profile_image
                        source: "image/edit-info.png"


            Label:

                text: "Full Name"
                color: 1,1,1,1
                halign: "left"
                text_size: self.size

            TextInput:
                id: full_name
                multiline: False
                hint_text: "Enter your full name"
                size_hint_y: None
                height: "45dp"
                background_normal:""
                background_color:0,0,0,0
                foreground_color:0,0,0,1
                cursor_color:0,0,0,1
                padding:[10,15,0,15]

                canvas.after:
                    Color:
                        rgba:1,1,1,.15
                    RoundedRectangle:
                        pos:self.pos
                        size:self.size
                        radius:[10]
                    Color:
                        rgba:1,1,1,1
                    Line:
                        rounded_rectangle:
                            (self.x,self.y,self.width,self.height,10)
                        width:1.2

            Label:
                text: "Email"
                color: 1,1,1,1
                halign: "left"
                text_size: self.size

            TextInput:
                id: email
                multiline: False
                hint_text: "Enter your email"
                size_hint_y: None
                height: "45dp"
                background_normal:""
                background_color:0,0,0,0
                foreground_color:0,0,0,1
                cursor_color:0,0,0,1
                padding:[10,15,0,15]

                canvas.after:
                    Color:
                        rgba:1,1,1,.15
                    RoundedRectangle:
                        pos:self.pos
                        size:self.size
                        radius:[10]
                    Color:
                        rgba:1,1,1,1
                    Line:
                        rounded_rectangle:
                            (self.x,self.y,self.width,self.height,10)
                        width:1.2

            Label:
                text: "Phone Number"
                color: 1,1,1,1
                halign: "left"
                text_size: self.size

            TextInput:
                id: phone
                multiline: False
                input_filter: "int"
                hint_text: "Enter phone number"
                size_hint_y: None
                height: "45dp"
                background_normal:""
                background_color:0,0,0,0
                foreground_color:0,0,0,1
                cursor_color:0,0,0,1
                padding:[10,15,0,15]

                canvas.after:
                    Color:
                        rgba:1,1,1,.15
                    RoundedRectangle:
                        pos:self.pos
                        size:self.size
                        radius:[10]
                    Color:
                        rgba:1,1,1,1
                    Line:
                        rounded_rectangle:
                            (self.x,self.y,self.width,self.height,10)
                        width:1.2

            BoxLayout:
                size_hint_y: None
                height: "50dp"
                spacing: "15dp"

                Button:
                    text: "Cancel"
                    background_normal: ""
                    background_color: .75,.2,.2,1
                    on_release:
                        app.root.current = "home"

                Button:
                    text: "Save Changes"
                    background_normal: ""
                    background_color: .1,.6,1,1
                    on_release:
                        root.update_profile()
                    canvas.after:
                        Color:
                            rgba:1,1,1,.15
                        RoundedRectangle:
                            pos:self.pos
                            size:self.size
                            radius:[10]

<PersonalizeScreen>:

    FloatLayout:

        canvas.before:
            Rectangle:
                pos: self.pos
                size: self.size


        Image:
            id:image
            source:"image/wisher-app-background_login.jpg"
            size:1,1
            fit_mode:"fill"
            pos:self.pos
            size:self.size

        Button:
            background_normal:"image/arrow_back.png"
            background_down:"image/arrow_back.png"
            size_hint:None,None
            size:40,40
            pos_hint:{"center_y":0.92,"center_x":0.06}
            on_press:
                app.root.current="home"


        BoxLayout:
            orientation: "vertical"
            size_hint: 0.65, 0.85
            pos_hint: {"center_x":0.5,"center_y":0.5}
            spacing: 20
            padding: 20

            canvas.before:
                Color:
                    rgba: 1,1,1,.15
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [20]
                Color:
                    rgba:1,1,1,.35
                Line:
                    rounded_rectangle:
                        (self.x,self.y,self.width,self.height,20)
                    width:1.2

            Label:
                id:personalize
                text: "Personalize"
                font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                font_size: "28sp"
                bold: True
                color: 1,1,1,1
                size_hint_y: None
                height: "45dp"

            ################################################

            Label:
                id:theme
                text: "Theme"
                font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                color: 1,1,1,1
                font_size: "18sp"
                text_size: self.size
                halign: "left"

            Spinner:
                id: theme_spinner
                text: "Light"
                values: ("Dark","Light")
                size_hint_y: None
                height: "45dp"

            ################################################

            Label:
                id:language
                text: "Language"
                color: 1,1,1,1
                font_size: "18sp"
                font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                text_size: self.size
                halign: "left"

            Spinner:
                id: language_spinner
                text: "English"
                #font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                font_name:"NotoSansDevanagari"
                values:
                    ("English",
                    "Hindi",
                    "French",
                    "Spanish")

                size_hint_y: None
                height: "45dp"
                #on_text:
                 #   root.translate()

            ################################################

            Label:
                id:font_size
                text: "Font Size"
                font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                color: 1,1,1,1
                font_size: "18sp"
                text_size: self.size
                halign: "left"

            Slider:
                id: font_slider
                min: 12
                max: 30
                value: 18
                step: 1

            Label:
                id: font_value
                font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                text: str(int(font_slider.value))
                color: 1,1,1,1
                font_size: "16sp"

            ################################################

            Label:
                id:accent
                text: "Accent Color"
                font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                color: 1,1,1,1
                font_size: "18sp"
                text_size: self.size
                halign: "left"

            BoxLayout:
                size_hint_y: None
                height: "45dp"
                spacing: 10

                Button:
                    background_normal: ""
                    background_color: 0.15,0.45,1,1
                    on_release:
                        root.select_color("Blue")

                Button:
                    background_normal: ""
                    background_color: 0.15,0.8,0.3,1
                    on_release:
                        root.select_color("Green")

                Button:
                    background_normal: ""
                    background_color: 0.75,0.25,1,1
                    on_release:
                        root.select_color("Purple")

                Button:
                    background_normal: ""
                    background_color: 1,0.2,0.2,1
                    on_release:
                        root.select_color("Red")

            Widget:

            ################################################

            BoxLayout:
                size_hint_y: None
                height: "50dp"
                spacing: 20

                Button:
                    id:restore
                    text: "Restore Default"
                    font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                    background_normal: ""
                    background_color: .7,.2,.2,1

                    on_release:
                        root.restore_default()

                Button:
                    id:save
                    text: app.language.translate("Save Settings")
                    #font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                    font_name:"NotoSansDevanagari"
                    background_normal: ""
                    background_color: .15,.55,1,1

                    on_release:
                        root.background_theme()
                        root.save_settings()

<HistoryScreen>:

    FloatLayout:

        canvas.before:
            Color:
                rgba: .08,.08,.08,1
            Rectangle:
                pos: self.pos
                size: self.size

        Button:
            background_normal:"image/arrow_back.png"
            background_down:"image/arrow_back.png"
            size_hint:None,None
            size:40,40
            pos_hint:{"center_y":0.96,"center_x":0.05}
            on_press:
                app.root.current="home"

        Label:
            text: "Wish History"
            font_size: "28sp"
            font_name:"NotoSans"
            bold: True
            color: 1,1,1,1
            size_hint: 1,None
            height: "60dp"
            pos_hint: {"top":1}

        TextInput:
            id: search
            hint_text: "Search by name..."
            multiline: False
            size_hint: .4,None
            height: "40dp"
            pos_hint: {"x":.03,"top":.90}
            on_text:
                root.search_history(self.text)

        GridLayout:
            cols: 7
            size_hint: .94,None
            height: "40dp"
            pos_hint: {"center_x":.5,"top":.82}
            spacing: 12

            canvas.before:
                Color:
                    rgba: .15,.15,.15,1
                Rectangle:
                    pos: self.pos
                    size: self.size

            Label:
                text:"Name"
                bold:True

            Label:
                text:"Platform"
                bold:True

            Label:
                text:"Contact"
                bold:True

            Label:
                text:"Subject"
                bold:True

            Label:
                text:"Date"

            Label:
                text:"Time"

            Label:
                text:"Status"

        ScrollView:
            size_hint:.94,.62
            pos_hint:{"center_x":.5,"y":.05}

            GridLayout:
                id: history_container
                cols:1
                spacing:15
                size_hint_y:None
                height:self.minimum_height


<SettingScreen>:

    FloatLayout:
        canvas.before:
            Rectangle:
                pos:self.pos
                size:self.size



        Image:
            id:image
            source:"image/wisher-app-background_login.jpg"
            size:1,1
            fit_mode:"fill"
            pos:self.pos
            size:self.size


        BoxLayout:
            orientation:"vertical"
            size_hint:None,1
            width:"155dp"
            spacing:10
            padding:[0,10,0,0]
            canvas.after:
                Color:
                    rgba: 1,1,1,1
                Line:
                    points: [self.right, self.y, self.right, self.top]
                    width: 1

            Button:
                id:back
                background_normal:"image/arrow_back.png"
                background_down:"image/arrow_back.png"
                size_hint:None,None
                size:40,40
                pos_hint:{"center_x":0.5}
                on_press:
                    app.root.current="home"

            Widget:
                size_hint_y:None
                height:15

            Button:
                id:general
                text:"General"
                font_size:"16sp"
                font_name:"NotoSans"
                size_hint_y:None
                size_hint_x:None
                width:"155dp"
                height:"45dp"
                #pos_hint:{"center_y":0.80}
                background_normal:""
                background_color:0,0,0,0
                background_down:""
                on_press:
                    root.show_general()

                canvas.before:
                    Color:
                        rgba:1,1,1,.15
                    Rectangle:
                        pos:self.pos
                        size:self.size

                    Color:
                        rgba:1,1,1,.35
                    Line:
                        rectangle:
                            (self.x,self.y,self.width,self.height)
                        width:1


