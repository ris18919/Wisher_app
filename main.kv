<WelcomeScreen>:

    FloatLayout:

        canvas.before:
            Rectangle:
                pos: self.pos
                size: self.size

        Image:
            id:image
            source:"image/welcome_screen_bg_image.jpg"
            fit_mode:"fill"
            size:self.size
            pos:self.pos
            size:1,1

        GradientLabel:
            id: welcome_label
            text: "Welcome to Wisher"
            size_hint:0.8,0.1
            pos_hint: {"center_x":0.5, "center_y":0.6}

<HomeScreen>:

    FloatLayout:
        size:self.size
        pos:self.pos
        canvas.before:
            Rectangle:
                pos:self.pos
                size:self.size

        Image:
            id:image
            source:"image/wisher-app-background_login.jpg"
            size:self.size
            pos:self.pos
            size:1,1
            fit_mode:"fill"

        FloatLayout:

            Label:
                id: home_label
                font_size:"30sp"
                pos_hint:{"center_y":0.85}



            Label:
                id:tagline
                text:"Never miss a special moment"
                font_size:"20sp"
                color:1, 0.84, 0, 1
                pos_hint:{"center_y":.80}
                size_hint_y:None
                height:self.texture_size[1] +dp(20)
                canvas.before:
                    Color:
                        rgba:1,1,1,1
                    Line:
                        points:[self.x,self.y,self.x+self.width,self.y]
                        width:1

            BoxLayout:
                orientation:"horizontal"
                size_hint:0.5,0.1
                pos_hint:{"center_x":0.5,"center_y":0.6}
                padding:[10,0,0,0]

                canvas.before:
                    Color:
                        rgba:1,1,1,.15
                    RoundedRectangle:
                        pos:self.pos
                        size:self.size
                        radius:[10]
                    Color:
                        rgba:1,1,1,1
                    Line:
                        rounded_rectangle:
                            (self.x,self.y,self.width,self.height,10)
                        width:1.2
                Image:
                    source:"image/email.png"
                    size_hint:None,None
                    size:30,30
                    pos_hint:{"center_y":0.75}


                BoxLayout:
                    orientation:"vertical"
                    spacing:2
                    Label:
                        id:total
                        text:"Total Wishes"
                        font_size:"16sp"
                        color:0,0,0,1
                        text_size:self.size
                        halign:"left"
                        valign:"top"
                        padding:[10,10,0,0]

                    Label:
                        id:wish_number
                        font_size:"14sp"
                        text:"0"
                        color:0,0,0,1
                        text_size:self.size
                        halign:"left"
                        valign:"middle"
                        padding:[30,10,0,20]

            BoxLayout:
                orientation:"horizontal"
                size_hint:0.5,0.1
                pos_hint:{"center_x":0.5,"center_y":0.45}
                padding:[10,0,0,0]

                canvas.before:
                    Color:
                        rgba:1,1,1,.15
                    RoundedRectangle:
                        pos:self.pos
                        size:self.size
                        radius:[10]
                    Color:
                        rgba:1,1,1,1
                    Line:
                        rounded_rectangle:
                            (self.x,self.y,self.width,self.height,10)
                        width:1.2

                Image:
                    source:"image/hourglass.png"
                    size_hint:None,None
                    size:30,30
                    pos_hint:{"center_y":0.75}

                BoxLayout:
                    orientation:"vertical"
                    spacing:2
                    Label:
                        id:pending
                        text:"Pending"
                        font_size:"16sp"
                        color:0,0,0,1
                        text_size:self.size
                        halign:"left"
                        valign:"top"
                        padding:[10,10,0,0]

                    Label:
                        id:pending_number
                        font_size:"14sp"
                        text:"0"
                        color:0,0,0,1
                        text_size:self.size
                        halign:"left"
                        valign:"middle"
                        padding:[30,10,0,20]

            BoxLayout:
                orientation:"horizontal"
                size_hint:0.5,0.1
                pos_hint:{"center_x":0.5,"center_y":0.30}
                padding:[10,0,0,0]

                canvas.before:
                    Color:
                        rgba:1,1,1,.15
                    RoundedRectangle:
                        pos:self.pos
                        size:self.size
                        radius:[10]
                    Color:
                        rgba:1,1,1,1
                    Line:
                        rounded_rectangle:
                            (self.x,self.y,self.width,self.height,10)
                        width:1.2

                Image:
                    source:"image/check.png"
                    size_hint:None,None
                    size:30,30
                    pos_hint:{"center_y":0.75}

                BoxLayout:
                    orientation:"vertical"
                    spacing:2
                    Label:
                        id:sent
                        text:"Sent"
                        font_size:"16sp"
                        color:0,0,0,1
                        text_size:self.size
                        halign:"left"
                        valign:"top"
                        padding:[20,10,0,0]

                    Label:
                        id:sent_number
                        font_size:"14sp"
                        text:"0"
                        color:0,0,0,1
                        text_size:self.size
                        halign:"left"
                        valign:"middle"
                        padding:[30,10,0,20]
            BoxLayout:
                orientation:"horizontal"
                size_hint:0.5,0.1
                pos_hint:{"center_x":0.5,"center_y":0.15}
                padding:[10,0,0,0]
                canvas.before:
                    Color:
                        rgba:1,1,1,.15
                    RoundedRectangle:
                        pos:self.pos
                        size:self.size
                        radius:[10]
                    Color:
                        rgba:1,1,1,1
                    Line:
                        rounded_rectangle:
                            (self.x,self.y,self.width,self.height,10)
                        width:1.2

                Image:
                    source:"image/close_30.png"
                    size_hint:None,None
                    size:30,30
                    pos_hint:{"center_y":0.75}


                BoxLayout:
                    orientation:"vertical"
                    spacing:2
                    Label:
                        id:failed
                        text:"Failed"
                        font_size:"16sp"
                        color:0,0,0,1
                        text_size:self.size
                        halign:"left"
                        valign:"top"
                        padding:[10,10,0,0]

                    Label:
                        id:failed_number
                        font_size:"14sp"
                        text:"0"
                        color:0,0,0,1
                        text_size:self.size
                        halign:"left"
                        valign:"middle"
                        padding:[30,10,0,20]

        Button:
            id:overlay
            opacity:0
            size_hint:1,1
            disabled:True
            background_color:0,0,0,0
            on_release:
                root.side_menu()
            canvas.before:
                Color:
                    rgba:0,0,0,self.opacity*0.45
                Rectangle:
                    pos:self.pos
                    size:self.size

        # Side Bar
        HoverButton:
            id: menu_btn
            size_hint:None,None
            size:30,30
            background_normal:"image/menu.png"
            background_down:"image/menu.png"
            background_color: 1,1,1,1
            pos_hint:{"x":0.03,"center_y":0.92}
            on_press:
                root.side_menu()

        BoxLayout:
            id:box
            orientation:"horizontal"
            size_hint:None,None
            size:"105dp","40dp"
            padding:[15,0,15,0]
            pos_hint:{"center_x":0.91,"center_y":0.92}

            canvas.before:
                Color:
                    rgba:0,0,0,0
                RoundedRectangle:
                    pos:self.pos
                    size:self.size
                    radius:[15]
                Color:
                    rgba:1,1,1,1
                Line:
                    rounded_rectangle:
                        (self.x,self.y,self.width,self.height,15)
                    width:1.2
            Image:
                source:"image/user.png"
                color:1, 1, 1, 1
                size_hint:None,None
                size:24,24
                pos_hint:{"center_x":0.5,"center_y":0.5}



            Spinner:
                id:profile
                text:""
                text_size:self.size
                halign:"left"
                valign:"middle"
                values:["Edit Profile"]
                color:1,1,1,1
                font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                font_size:"16sp"
                size_hint:None,None
                size:80,40
                background_normal:""
                background_color:(0.2, 0.5, 1, 1) if self.state == "down" else (0,0,0,0)
                padding:[0,0,0,1]
                pos_hint:{"center_y":0.5}
                width:box.width

                dropdown_cls:'DropDown'
                option_cls:'ProfileSpinnerOption'
                #dropdown_properties:{"auto_width":False,width:box.width}

                # Triggers when a user picks an option
                on_text: root.on_spinner_select(self.text)

        DropDown:
            auto_width:False
            width:box.width

        BoxLayout:
            id: side_panel
            orientation:"vertical"
            pos_hint:{"center_y":0.45}
            size_hint:0.26,0.7
            x:-self.width
            y:0.5
            spacing: 18
            padding: 25
            disabled:True
            opacity:0

            canvas.before:
                Color:
                    rgba: root.side_panel_color
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [5]

                #Line:
                #    rounded_rectangle:
                #        (self.x,self.y,self.width,self.height,5)
                #    width:1.2

            BoxLayout:
                orientation:"horizontal"
                size_hint_x:None
                size_hint_y:None
                width:"160dp"
                height:"40dp"
                pos_hint:{"center_x":0.5}
                padding:[15,0,5,0]
                canvas.before:
                    Color:
                        rgba:1,1,1,.15
                    RoundedRectangle:
                        pos:self.pos
                        size:self.size
                        radius:[10]

                    Color:
                        rgba:1,1,1,1
                    Line:
                        rounded_rectangle:
                            (self.x,self.y,self.width,self.height,10)
                        width:1

                Image:
                    source:"image/home.png"
                    size_hint:None,None
                    size:30,30
                    pos_hint:{"center_x":0.5,"center_y":0.5}



                HoverButton:
                    id:home
                    text:app.language.translate("Home")
                    text_size:self.size
                    halign:"center"
                    font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                    bold:True
                    font_size:"20sp"
                    size_hint_y:None
                    height:35
                    pos_hint:{"center_x":0.5,"center_y":0.5}
                    background_normal:""
                    background_down:""
                    background_color:0,0,0,0
                    on_press:
                        root.side_menu()
                        app.root.current="home"

            BoxLayout:
                orientation:"horizontal"
                size_hint_x:None
                size_hint_y:None
                width:"160dp"
                height:"40dp"
                padding:[15,0,5,0]
                pos_hint:{"center_x":0.5}
                canvas.before:
                    Color:
                        rgba:1,1,1,.15
                    RoundedRectangle:
                        pos:self.pos
                        size:self.size
                        radius:[10]

                    Color:
                        rgba:1,1,1,1
                    Line:
                        rounded_rectangle:
                            (self.x,self.y,self.width,self.height,10)
                        width:1

                Image:
                    id:add_image
                    source:"image/add.png"
                    color:0.7, 0.5, 0.9, 1
                    size_hint:None,None
                    size:24,24
                    pos_hint:{"center_x":0.5,"center_y":0.5}

                HoverButton:
                    id: add
                    text:app.language.translate("Add Wish")
                    font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                    bold:True
                    font_size:"20sp"
                    size_hint_y:None
                    height:35
                    pos_hint:{"center_x":0.5,"center_y":0.5}
                    background_normal:""
                    background_down:""
                    background_color:0,0,0,0
                    on_press:
                        root.side_menu()
                        app.root.current="add_wish"
            BoxLayout:
                orientation:"horizontal"
