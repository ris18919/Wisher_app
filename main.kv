<RoundedButton@Button>
    background_normal: ""
    background_down: ""
    background_color: 0,0,0,0
    #color: 1,1,1,1
    bold: True

    canvas.before:
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [20,20,20,20]
            texture:Gradient.horizontal((0.0, 0.42, 1.0, 1.0),(1.0, 0.411, 0.705, 1.0))

<RoundedOutlineButton@Button>:
    background_normal: ""
    background_down: ""
    background_color: 0,0,0,0
    color: 1,1,1,1

    canvas.before:
        Color:
            rgba: 1,1,1,.12
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [20,20,20,20]

        Color:
            rgba: 1,1,1,.5
        Line:
            rounded_rectangle:
                (self.x, self.y, self.width, self.height, 20)
            width: 1.2


WindowManager:
    FlashScreen:
        name:"flash"
    LoginScreen:
        name: "login"

    SignUpScreen:
        name: "signup"

    WelcomeScreen:
        name: "welcome"

    AddWishScreen:
        name: "add_wish"

    HomeScreen:
        name:"home"

    EditProfileScreen:
        name: "edit_profile"

    PersonalizeScreen:
        name: "personalize"

    HistoryScreen:
        name:"history"

    SettingScreen:
        name:"setting"

    DashboardScreen:
        name:"dashboard"

    ForgotPasswordScreen:
        name:"forgot"

<FlashScreen>:
    FloatLayout:
        background_normal:""
        canvas.before:
            Color:
                rgba: 0.96, 0.95, 0.93, 1
            Rectangle:
                pos:self.pos
                size:self.size

        # Background (fills entire screen)
        Image:
            source:"image/flash_screen_ui_background.png"
            size_hint:1,1
            fit_mode:"fill"
            pos:self.pos
            size:self.size



        # Center Logo (never stretches)
        Image:
            id: splash_logo
            source: "image/wisher-logo-login_screen.png"
            size_hint: None, None
            # Responsive size
            size:
                min(root.width * 0.28, 350), \
                min(root.height * 0.28, 350)
            pos_hint:
                {"center_x": 0.5, "center_y": 0.5}



        Label:
            id:splash_label
            text:"Wisher"
            font_size:"40sp"
            font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
            opacity:1
            pos_hint:{"center_y":0.37}
            color:0.36, 0.25, 0.20, 1

        ProgressBar:
            id: loading_bar
            max: 100
            value: 0
            size_hint: .45,None
            height: 8
            pos_hint: {"center_x":0.5,"y":0.08}

        Label:
            id: loading_text
            text: "Loading..."
            font_size: "16sp"
            color: 0.36, 0.25, 0.20, 1
            pos_hint: {"center_x":0.5,"center_y":0.15}

<LoginScreen>:

    FloatLayout:
        # 🔵 Background Color
        id:login

        canvas.before:
            Rectangle:
                pos: self.pos
                size: self.size
                #source: "image/wisher-app-background_login.jpg"

        Image:
            id:image
            source:"image/wisher-app-background_login.jpg"
            size:1,1
            fit_mode:"fill"
            pos:self.pos
            size:self.size

        BoxLayout:
            orientation:"horizontal" if self.width>self.height else "vertical"
            size:self.size
            spacing:10
            padding:10
            background_normal:""
            background_active:""


            #  Login Panel
            AnchorLayout:
                anchor_x:"center"
                anchor_y:"center"

                BoxLayout:
                    orientation:'vertical'
                    spacing:20
                    size_hint:.45,.75
                    size_hint_x:None
                    padding:[35,30,35,40]
                    width:min(root.width*0.4, 500)
                    height:min(root.height*0.7,550)

                    canvas.before:
                        Color:
                            rgba:1,1,1,.15

                        RoundedRectangle:
                            pos:self.pos
                            size:self.size
                            radius:[20]
                        Color:
                            rgba: 1,1,1,0.35
                        Line:
                            rounded_rectangle:
                                (self.x, self.y, self.width, self.height, 20)
                            width: 1.2
                    Image:
                        source:"image/wisher-logo-login_screen.png"
                        size_hint:None,None
                        size:170,170

                        pos_hint:{"center_x":0.5}
                    Label:
                        text: "Wisher"
                        font_size: "32sp"
                        padding:[0,0,0,50]
                        font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                        bold: True
                        color: 1,1,1,1


                    Label:
                        text: "Never forget special moments"
                        font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                        font_size: "18sp"
                        color: 1.0,0.84,0,1.0
                        padding:[0,0,0,10]

                    BoxLayout:
                        orientation:'horizontal'
                        size_hint_y:None
                        height:dp(50)
                        padding:[15,5]


                        canvas.before:
                            Color:
                                rgba:1,1,1,.15

                            RoundedRectangle:
                                pos:self.pos
                                size:self.size
                                radius:[20]
                            Color:
                                rgba: 1,1,1,0.35
                            Line:
                                rounded_rectangle:
                                    (self.x, self.y, self.width, self.height, 20)
                                width: 1.2

                        Image:
                            source:"image/person_30 white.png"
                            size_hint:None,None
                            size:30,30
                            pos_hint:{"center_y":0.5}

                        TextInput:

                            id:login_email
                            hint_text:"Email or Phone"
                            hint_text_color:1,1,1,1
                            font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                            multiline:False
                            background_normal:""
                            background_active:""
                            background_color:0,0,0,0
                            foreground_color:0,0,0,1
                            cursor_color:0,0,0,1
                            padding:[5,12,0,12]

                    BoxLayout:
                        orientation:'horizontal'
                        size_hint_y:None
                        height:60
                        padding:[15,5]
                        canvas.before:
                            Color:
                                rgba:1,1,1,.15

                            RoundedRectangle:
                                pos:self.pos
                                size:self.size
                                radius:[20]
                            Color:
                                rgba: 1,1,1,0.35
                            Line:
                                rounded_rectangle:
                                    (self.x, self.y, self.width, self.height, 20)
                                width: 1.2

                        Image:
                            source:"image/lock_30 white.png"
                            size_hint:None,None
                            size:30,30

                            pos_hint:{"center_y":0.5}

                        TextInput:
                            id:login_password
                            hint_text:"Password"
                            hint_text_color:1,1,1,1
                            password:True
                            font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                            size_hint_x:.85
                            multiline:False
                            background_normal:""
                            background_active:""
                            background_color:0,0,0,0   # transparent
                            foreground_color:0,0,0,1
                            cursor_color:0,0,0,1
                            padding:[5,12,0,12]

                         # 👁 RIGHT VISIBILITY ICON
                        HoverButton:
                            id: visibility_btn
                            background_normal:"image/visibility_off_30.png"
                            background_down:"image/visibility_off_30.png"
                            size_hint:None,None
                            size:30,30
                            pos_hint:{"center_y":.5}
                            on_press:
                                root.toggle_password()


                    #Login Button

                    HoverButton:

                        text: "Login"

                        font_size: "20sp"
                        font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                        bold: True

                        size_hint_y: None
                        height: 60

                        background_normal: ""
                        background_down: ""

                        background_color: 0, 0, 0, 0

                        color: 1,1,1,1


                        canvas.before:

                            #Color:
                                #rgba: .35,.3,.95,1

                            RoundedRectangle:
                                pos: self.pos
                                size: self.size

                                # Large radius = pill shape
                                radius: [20]
                                texture:Gradient.horizontal((0.0, 0.42, 1.0, 1.0),(1.0, 0.411, 0.705, 1.0))

                        on_press:root.signin_user()

                    #forgot password
                    HoverButton:
                        text: "Forgot Password?"
                        markup:True
                        font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                        background_normal: ""
                        background_color: 0, 0, 0, 0   # transparent
                        color: 0.2, 0.5, 1, 1              # blue text
                        size_hint: None, None
                        size: self.texture_size
                        pos_hint: {"center_x":0.5,"center_y":0.2}
                        on_press: app.root.current = "forgot"

                    Label:
                        text:"──────── Or Continue With ────────"
                        font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                        color:1,1,1,1

                    BoxLayout:
                        orientation:"horizontal"
                        color:1,1,1,1
                        background_normal:""
                        spacing:15
                        halign:"center"
                        size_hint_y:None
                        height:55
                        padding:[55,0]


                        canvas.before:
                            Color:
                                rgba: 1,1,1,.15
                            RoundedRectangle:
                                pos:self.pos
                                size:self.size
                                radius:[20]
                            Color:
                                rgba: 1,1,1,0.35
                            Line:
                                rounded_rectangle:
                                    (self.x, self.y, self.width, self.height, 20)
                                width: 1.2

                        Image:
                            source:"image/google.png"
                            size_hint_x:None
                            size_hint_y:None
                            height:30
                            width:30
                            pos_hint:{"center_y":0.5}



                        HoverButton:
                            text:"Login with Google"
                            font_size:"18sp"
                            font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                            background_normal:""
                            background_down:""
                            background_color: 0,0,0,0
                            bold:True
                            on_press:
                                root.start_google_login()

                    BoxLayout:
                        orientation:'horizontal'
                        size_hint:None,None
                        spacing:2
                        width:self.minimum_width
                        height:20
                        pos_hint:{"center_x":0.5}
                        padding:[110,0,100,0]
                        Label:
                            text:"Don't have an account?"
                            font_size:"16sp"
                            size_hint_x:None
                            width:self.texture_size[0]
                            font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                            #pos_hint:{"center_y":0.9}

                        HoverButton:
                            text:"Sign Up"
                            font_size:"12sp"
                            font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                            background_normal:""
                            background_color:0,0,0,0
                            color:.30,.30,.95,1
                            bold:True
                            size_hint_x:None

                            #height:50
                            width:self.texture_size[0] +dp(10)

                            #pos_hint:{"center_y":0.9}
                            on_press:
                                app.root.current="signup"




<SignUpScreen>:

    FloatLayout:

        canvas.before:
            Rectangle:
                pos: self.pos
                size: self.size

        Image:
            id:image
            source:"image/wisher-app-background_login.jpg"
            size:1,1
            fit_mode:"fill"
            pos:self.pos
            size:self.size

        BoxLayout:
            orientation: "vertical"
            size_hint: 0.45, 0.87
            size_hint_x:None
            pos_hint: {"center_x":0.5,"center_y":0.5}
            spacing: 15
            padding: [35,35,35,25]
            width:min(root.width*0.4, 500)
            height:min(root.height*0.7,550)

            canvas.before:
                Color:
                    rgba: 1,1,1,0.15

                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [35]

                Color:
                    rgba: 1,1,1,0.5

                Line:
                    rounded_rectangle:
                        (self.x,self.y,self.width,self.height,35)
                    width: 1.3

            Widget:
                size_hint_y: .5


            Image:
                source: "image/person_38.png"
                size_hint: None,None
                size: 75,75
                pos_hint: {"center_x":0.5}
                canvas.before:
                    Color:
                        rgba:1,1,1,0.15
                    RoundedRectangle:
                        size:self.size
                        pos:self.pos
                        radius:[35]


            #Image:
                #source:"sparkling.png"
                #size_hint:None,None
                #size:30,30

            Label:
                text: "Create Account"
                markup:True
                font_size: "32sp"
                font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                bold: True
                color: 1,1,1,1
                size_hint_y: None
                height: 25


            Label:
                text: "Join Wisher and automate your wishes"
                font_size: "16sp"
                font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                color: 1.0,0.84,0,1.0
                size_hint_y: None
                height: 30


            BoxLayout:
                orientation:"horizontal"
                size_hint_y:None
                height:dp(50)
                padding:[15,15]
                pos_hint:{"center_x":0.5}

                canvas.before:
                    Color:
                        rgba: 1,1,1,0.15
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [20]

                    Color:
                        rgba: 1,1,1,0.35
                    Line:
                        rounded_rectangle:
                            (self.x, self.y, self.width, self.height, 20)
                        width: 1.2

                Image:
                    source:"image/person_30 white.png"
                    size_hint:None,None
                    size:30,30



                TextInput:
                    id:signup_name
                    hint_text: "Full Name"
                    size_hint_x:.85
                    size_hint_y:None
                    height:dp(23)
                    font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                    hint_text_color:1,1,1,1
                    multiline: False
                    background_normal: ""
                    background_active: ""
                    background_color: 0,0,0,0
                    foreground_color: 0,0,0,1
                    cursor_color: 0,0,0,1
                    pos_hint:{"center_y":0.5}
                    padding:[10,2,0,2]

            BoxLayout:
                orientation:"horizontal"
                size_hint_y:None
                height:dp(50)
                padding:[15,15]
                pos_hint:{"center_x":0.5}

                canvas.before:
                    Color:
                        rgba: 1,1,1,0.15
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [20]

                    Color:
                        rgba: 1,1,1,0.35
                    Line:
                        rounded_rectangle:
                            (self.x, self.y, self.width, self.height, 20)
                        width: 1.2

                Image:
                    source:"image/mail_30.png"
                    size_hint:None,None
                    size:30,30

                TextInput:
                    id:signup_email
                    hint_text: "Email Address"
                    size_hint_x:.85
                    font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                    hint_text_color:1,1,1,1
                    multiline: False
                    background_normal: ""
                    background_active: ""
                    background_color: 0,0,0,0
                    foreground_color: 0,0,0,1
                    cursor_color: 0,0,0,1
                    padding:[10,2,0,2]

            BoxLayout:
                orientation:"horizontal"
                size_hint_y:None
                height:dp(50)
                padding:[15,15]
                pos_hint:{"center_x":0.5}

                canvas.before:
                    Color:
                        rgba: 1,1,1,0.15
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [20]

                    Color:
                        rgba: 1,1,1,0.35
                    Line:
                        rounded_rectangle:
                            (self.x, self.y, self.width, self.height, 20)
                        width: 1.2

                Image:
                    source:"image/lock_30 white.png"
                    size_hint:None,None
                    size: 30,30

                TextInput:
                    id:signup_password
                    hint_text: "Password"
                    password:True
                    size_hint_x:.85
                    font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                    hint_text_color:1,1,1,1
                    multiline: False
                    background_normal: ""
                    background_active: ""
                    background_color: 0,0,0,0
                    foreground_color: 0,0,0,1
                    cursor_color: 0,0,0,1
                    padding:[10,2,0,2]

                #Right Visibility
                HoverButton:
                    id:signup_visibility
                    background_normal:"image/visibility_off_30.png"
                    background_down:"image/visibility_off_30.png"
                    color:1,1,1,1
                    size_hint:None,None
                    size:30,30
                    pos_hint:{"center_y":.5}
                    on_press:
                        root.toggle_password()


            BoxLayout:
                orientation:"horizontal"
                size_hint_y:None
                height:dp(50)
                padding:[15,15]
                pos_hint:{"center_x":0.5}

                canvas.before:
                    Color:
                        rgba: 1,1,1,0.15
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [20]

                    Color:
                        rgba: 1,1,1,0.35
                    Line:
                        rounded_rectangle:
                            (self.x, self.y, self.width, self.height, 20)
                        width: 1.2

                Image:
                    source:"image/call_30.png"
                    size_hint:None,None
                    size:30,30

                TextInput:
                    id:signup_phone
                    hint_text: "Phone"
                    size_hint_x:.85
                    font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                    hint_text_color:1,1,1,1
                    multiline: False
                    background_normal: ""
                    background_active: ""
                    background_color: 0,0,0,0
                    foreground_color: 0,0,0,1
                    cursor_color: 0,0,0,1
                    padding:[10,2,0,2]

            HoverButton:
                text: "Create Account"
                size_hint_y: None
                height: dp(50)
                bold: True
                font_size: "20sp"
                background_normal: ""
                background_down: ""
                background_color: 0,0,0,0
                #color: 1,1,1,1
                bold: True
                on_press:
                    root.signup_user()

                canvas.before:
                    Color:
                        rgba:1,1,1,1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [20,20,20,20]
                        texture:Gradient.horizontal((0.0, 0.42, 1.0, 1.0),(1.0, 0.411, 0.705, 1.0))

            BoxLayout:
                size_hint_y: None
                height: 40
                spacing: 10

                Widget
                Label:
                    text: "OR"
                    font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                    color: 1,1,1,1
                    size_hint_x: None
                    width: 40

                Widget

            BoxLayout:
                orientation:"horizontal"
                size_hint_y:None
                height:60
                padding:[50,0]
                spacing:20
                pos_hint:{"center_x":0.5}

                canvas.before:
                    Color:
                        rgba: 1,1,1,.15
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [20]

                    Color:
                        rgba: 1,1,1,.35
                    Line:
                        rounded_rectangle:
                            (self.x, self.y, self.width, self.height, 20)
                        width: 1.2

                Image:
                    source:"image/google.png"
                    size_hint_y:None
                    size_hint_x:None
                    height:30
                    width:30
                    pos_hint:{"center_y":0.5}

                HoverButton:
                    text: "Sign up with Google"
                    font_size: "18sp"
                    bold: True
                    font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                    background_normal: ""
                    background_down:""
                    background_active:""
                    background_color: 0,0,0,0
                    pos_hint:{"center_y":0.5}
                    on_press: root.start_google_signup()

            Label:
                markup: True
                text: "Already have an account? [color=4d6fff][ref=login]Login[/ref][/color]"
                font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                color: 1,1,1,1
                size_hint_y: None
                height: 30

                on_ref_press:
                    app.root.current = "login"
<ForgotPasswordScreen>:

    FloatLayout:
        canvas.before:
            Rectangle:
                pos: self.pos
                size: self.size

        Image:
            id:image
            source:"image/wisher-app-background_login.jpg"
            size:1,1
            fit_mode:"fill"
            pos:self.pos
            size:self.size

        BoxLayout:
            orientation:"vertical"
            size_hint:0.48,0.51
            size_hint_x:None
            size_hint_y:None
            pos_hint:{"center_x":0.5,"center_y":0.5}
            spacing: 15
            padding: [25,25,25,25]
            width:min(root.width*0.4, 500)
            height:min(root.height*0.7,550)
            canvas.before:
                Color:
                    rgba: 1,1,1,0.15
                RoundedRectangle:
                    pos:self.pos
                    size:self.size
                    radius:[20]
                Color:
                    rgba:1,1,1,0.35

                Line:
                    rounded_rectangle:
                        (self.x, self.y, self.width, self.height, 20)
                    width: 1.2

            Label:
                text: "Reset Password"
                font_size: "30sp"
                size_hint_y:None
                height:50

            BoxLayout:
                orientation:"horizontal"
                size_hint_y:None
                height:60
                padding:[15,15,15,15]
                canvas.before:
                    Color:
                        rgba: 1,1,1,0.15
                    RoundedRectangle:
                        pos:self.pos
                        size:self.size
                        radius:[20]
                    Color:
                        rgba:1,1,1,0.35

                    Line:
                        rounded_rectangle:
                            (self.x, self.y, self.width, self.height, 20)
                        width: 1.2

                Image:
                    source:"image/mail_30.png"
                    size_hint:None,None
                    size:30,30


                TextInput:
                    id: fp_email
                    hint_text: "Enter your Email"
                    hint_text_color: 1,1,1,1
                    font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                    multiline:False
                    background_color: 0,0,0,0
                    foreground_color:0,0,0,1
                    cursor_color:0,0,0,1
                    background_normal:""
                    background_active:""
                    padding:[10,2,0,2]

                HoverButton:
                    text:"Send OTP"
                    color:0,0,1,1
                    font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                    font_size:"10sp"
                    size_hint_x:None
                    width:55
                    background_normal: ""
                    background_down: ""
                    background_color: 0,0,0,0
                    padding:[0,0,0,0]
                    on_press:
                        root.send_otp()

            BoxLayout:
                orientation:"horizontal"
                size_hint_y:None
                height:60
                spacing:10
                opacity:0
                id:otp_input_box

                canvas.before:
                    Color:
                        rgba: 1,1,1,0.15
                    RoundedRectangle:
                        pos:self.pos
                        size:self.size
                        radius:[20]
                    Color:
                        rgba:1,1,1,0.35

                    Line:
                        rounded_rectangle:
                            (self.x, self.y, self.width, self.height, 20)
                        width: 1.2
                TextInput:
                    id: otp_input
                    hint_text:"OTP"
                    hint_text_color:1,1,1,1
                    font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                    size_hint_y:None
                    size_hint_x:None
                    height:50
                    padding:[10,5,10,5]
                    background_normal: ""
                    background_down: ""
                    background_color: 0,0,0,0
                    bold: True
                    disabled:True
            BoxLayout:
                orientation:"horizontal"
                spacing:10
                size_hint_x:None
                size_hint_y:None
                height:40
                padding:[110,0,0,0]
                Button:
                    id:verify_btn
                    text:"Verify"
                    color:0,0,1,1
                    font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                    font_size:"16sp"
                    size_hint_x:None
                    size_hint_y:None
                    height:45
                    opacity:0
                    disabled:True
                    background_normal: ""
                    background_down: ""
                    background_color: 0,0,0,0
                    padding:[0,0,0,0]
                    on_press:
                        root.verify_otp()
                    canvas.before:
                        Color:
                            rgba:1,1,1,.15
                        RoundedRectangle:
                            pos:self.pos
                            size:self.size
                            radius:[20,20,20,20]
                        Color:
                            rgba:1,1,1,.35
                        Line:
                            rounded_rectangle:
                                (self.x,self.y,self.width,self.height,20)
                            width:1.2

                HoverButton:
                    id: resend_btn
                    color:0,0,1,1
                    font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                    font_size:"11sp"
                    size_hint_x:None
                    size_hint_y:None
                    height:45
                    width:120
                    background_normal: ""
                    background_down: ""
                    background_color: 0,0,0,0
                    padding:[0,0,0,0]
                    disabled: True
                    opacity: 0
                    on_press:
                        root.resend_otp()

                    canvas.before:
                        Color:
                            rgba:1,1,1,.15
                        RoundedRectangle:
                            pos:self.pos
                            size:self.size
                            radius:[20,20,20,20]
                        Color:
                            rgba:1,1,1,.35
                        Line:
                            rounded_rectangle:
                                (self.x,self.y,self.width,self.height,20)
                            width:1.2

            BoxLayout:
                orientation:"horizontal"
                size_hint_y:None
                height:60
                padding:[15,15,15,15]
                opacity:0
                disabled:True
                id: fp_password

                canvas.before:
                    Color:
                        rgba: 1,1,1,0.15
                    RoundedRectangle:
                        pos:self.pos
                        size:self.size
                        radius:[20]
                    Color:
                        rgba:1,1,1,0.35

                    Line:
                        rounded_rectangle:
                            (self.x, self.y, self.width, self.height, 20)
                        width: 1.2

                Image:
                    source:"image/lock_30 white.png"
                    size_hint:None,None
                    size:30,30

                TextInput:
                    id: new_password
                    hint_text:"New Password"
                    hint_text_color: 1,1,1,1
                    font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                    multiline:False
                    background_color: 0,0,0,0
                    foreground_color:0,0,0,1
                    cursor_color:0,0,0,1
                    background_normal:""
                    background_active:""
                    padding:[10,2,0,2]

                # visibility button
                HoverButton:
                    id:new_visibility
                    background_normal:"image/visibility_off_30.png"
                    background_down:"image/visibility_off_30.png"
                    color:1,1,1,1
                    size_hint:None,None
                    size:30,30
                    pos_hint:{"center_y":.5}
                    on_press:
                        root.toggle_password()


            BoxLayout:
                orientation:"horizontal"
                size_hint_y:None
                height:60
                padding:[110,0]
                halign:"center"
                spacing:10
                opacity:0
                disabled:True
                id:fp_reset_btn


                canvas.before:
                    Color:
                        rgba: 1,1,1,1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [20]
                        texture:Gradient.horizontal((0.0, 0.42, 1.0, 1.0),(1.0, 0.411, 0.705, 1.0))

                    Color:
                        rgba: 1,1,1,.35
                    Line:
                        rounded_rectangle:
                            (self.x, self.y, self.width, self.height, 20)
                        width: 1.2

                HoverButton:
                    text: "Reset Password"
                    bold: True
                    font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                    background_normal: ""
                    background_down:""
                    background_active:""
                    background_color: 0,0,0,0
                    on_press: root.reset_password()
            BoxLayout:
                orientation:"horizontal"
                pos_hint:{"center_x":0.5}
                size_hint_x:None
                size_hint_y:None
                width:130
                height:50
                canvas.before:
                    Color:
                        rgba:1,1,1,.15
                    RoundedRectangle:
                        pos:self.pos
                        size:self.size
                        radius:[20]
                    Color:
                        rgba:1,1,1,.35
                    Line:
                        rounded_rectangle:
                            (self.x,self.y,self.width,self.height,20)
                        width:1.2
                HoverButton:
                    text: "Back to Login"
                    color:0.30, 0.437, 1.0, 1.0
                    background_color:0,0,0,0
                    background_normal:""
                    background_active:""
                    on_press: app.root.current = "login"



<AddWishScreen>:

    FloatLayout:

        # 🌈 Background Gradient Feel

        canvas.before:
            Rectangle:
                pos: self.pos
                size: self.size
                #texture:Gradient.vertical((0.0, 0.42, 1.0, 1.0),(1.0, 0.411, 0.705, 1.0))


        Image:
            id:image
            source:"image/wisher-app-background_login.jpg"
            size:1,1
            fit_mode:"fill"
            pos:self.pos
            size:self.size

        # 🎉 Top Title
        Label:
            text: "Schedule a Wish"
            font_name:"NotoSans"
            font_size: 34
            color: 1,1,1,1
            pos_hint: {"center_x":0.5,"center_y":0.9}


        # ✨ Subtitle
        Label:
            text: "Make every moment special"
            font_name:"NotoSans"
            font_size: 16
            color: 1.0,0.84,0,1.0
            pos_hint: {"center_x":0.5,"center_y":0.85}




        # 📦 Main Card
        BoxLayout:
            id:wish_content
            disabled:False
            orientation: "vertical"
            size_hint: 0.45, 0.72
            pos_hint: {"center_x":0.5, "center_y":0.45}
            spacing: 18
            padding: 25
            canvas.before:
                Color:
                    rgba: 1,1,1,.15
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [30]
                Color:
                    rgba:1,1,1,.35
                Line:
                    rounded_rectangle:
                        (self.x,self.y,self.width,self.height,30)
                    width:1.2

            BoxLayout:
                size_hint:0.9,0.1
                pos_hint:{"center_x":0.5}
                padding:[30,0,0,0]
                canvas.before:
                    Color:
                        rgba:1,1,1,.15
                    RoundedRectangle:
                        pos:self.pos
                        size:self.size
                        radius:[10]
                    Color:
                        rgba: 1,1,1,.35
                    Line:
                        rounded_rectangle:
                            (self.x,self.y,self.width,self.height,10)
                        width:1.2

                Button:
                    id:mode
                    text:"Select Platform"
                    color: 1,1,1,1
                    font_size:"16sp"
                    font_name:"fonts/Noto_Sans/NotoSans-VariableFont.ttf"
                    size_hint_x:None
                    width:"145dp"
                    background_normal:""
                    background_color:0,0,0,0
                    padding:[10,0,0,0]
                    #pos_hint:{"center_x":0.5}
                    on_release:
                        root.open_platform_dialog()

                Image:
                    source:"image/arrow_down_30.png"
                    size_hint:None,None
                    size:30,30
                    pos_hint:{"center_y":0.5}


            BoxLayout:
                size_hint:0.9,0.1
