                    size:30,30
                    pos_hint:{"center_y":0.5}
                    on_release:
                        root.date_picker()


            BoxLayout:
                size_hint:0.9,0.1
                padding:[10,0,10,0]
                pos_hint:{"center_x":0.5}
                canvas.before:
                    Color:
